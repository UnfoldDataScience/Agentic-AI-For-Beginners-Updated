# Copy this file to ".env" (same folder) and fill in YOUR OWN values.
# Never share or commit your .env file - it is excluded by .gitignore.
# Write values without quotes. You only need the keys for the lessons you run.

# ---------------------------------------------------------------- Parts 1, 2 and 3
# OpenAI: https://platform.openai.com/api-keys  (billing must be enabled)
OPENAI_API_KEY=your-openai-api-key-here

# ---------------------------------------------------------------- Part 1 (optional)
# Tavily web search, only used if DuckDuckGo search is rate-limited: https://app.tavily.com/home
TAVILY_API_KEY=

# ---------------------------------------------------------------- Part 3 - AutoGen
# Groq (free tier available): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Optional: override the Groq model (default: openai/gpt-oss-120b)
GROQ_MODEL=

# ---------------------------------------------------------------- Part 3 - Langflow (TestMyAgent.py)
# From your flow's API panel in Langflow
LANGFLOW_APPLICATION_TOKEN=
LANGFLOW_ID=
LANGFLOW_FLOW_ID=
# Optional: only if your Langflow server is not the DataStax-hosted one
LANGFLOW_BASE_URL=

# ---------------------------------------------------------------- Part 4 - AWS Bedrock
# AWS credentials are NOT stored here - sign in with `aws configure` instead.
AWS_REGION=us-east-1
# Optional: any Bedrock text model you have enabled (default: amazon.titan-text-express-v1)
BEDROCK_MODEL_ID=
# From YOUR Bedrock agent (Bedrock console -> Agents)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
# The IAM role your user assumes to invoke the agent, e.g. arn:aws:iam::<your-account-id>:role/<your-role-name>
BEDROCK_INVOKE_ROLE_ARN=

# ---------------------------------------------------------------- Optional: turn off anonymous usage statistics
# Remove the "# " to opt out (see LOCAL_SETUP.MD, "Do the AI libraries send usage data?")
# CREWAI_DISABLE_TELEMETRY=true
# AGNO_TELEMETRY=false
# ANONYMIZED_TELEMETRY=False
